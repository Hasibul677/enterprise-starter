# MongoDB connection string - replace with your own; never commit real credentials here.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/enterprise-starter

# JWT secrets - generate strong random values, e.g. `openssl rand -base64 48`
# Use DIFFERENT secrets for access vs refresh tokens.
ACCESS_TOKEN_SECRET=dev-access-secret-7fK2mP9xL4vN8qR3tY6wC1aB5sD0eF9gH
REFRESH_TOKEN_SECRET=dev-refresh-secret-3nV8xQ2pL7mK5rT9yW4cA6bD1eF0gH2j

JWT_ISSUER=enterprise-starter
JWT_AUDIENCE=enterprise-starter-clients

ACCESS_TOKEN_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN=45m

# Idempotent seed script (`yarn seed`) creates/updates this account.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Number of reverse proxies in front of this app that are trusted to
# correctly APPEND the real client IP to X-Forwarded-For (used for rate
# limiting - see src/lib/security/rate-limit.ts). Leave at 0 (the default)
# unless you have verified your deployment's proxy/load-balancer topology -
# trusting this header without a real proxy lets a client bypass rate
# limits by spoofing a fresh value on every request.
TRUSTED_PROXY_HOPS=0

NEXT_PUBLIC_APP_NAME=Enterprise Starter

# Optional "Demo Account" panel on /login - shown only when BOTH are set.
# Point these at a dedicated, low-privilege (non-Super-Admin) review
# account only - never a real user's credentials, and never the Super
# Admin account. Leave both unset (the default) to hide the panel.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
